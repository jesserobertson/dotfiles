# Determine OS
{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

# Detect 1Password CLI availability
{{- $has1password := false -}}
{{- if lookPath "op" -}}
{{-   $has1password = true -}}
{{- end -}}

# Determine number of CPU cores and threads
{{- $cpuCores := 1 }}
{{- $cpuThreads := 1 }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $cpuCores = (output "/usr/sbin/sysctl" "-n" "hw.physicalcpu_max") | trim | atoi }}
{{-   $cpuThreads = (output "/usr/sbin/sysctl" "-n" "hw.logicalcpu_max") | trim | atoi }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $cpuCores = (output "sh" "-c" "lscpu --online --parse | grep --invert-match '^#' | sort --field-separator=',' --key='2,4' --unique | wc --lines") | trim | atoi }}
{{-   $cpuThreads = (output "sh" "-c" "lscpu --online --parse | grep --invert-match '^#' | wc --lines") | trim | atoi }}
{{- else if eq .chezmoi.os "windows" }}
{{-   $cpuCores = (output "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" "-NoProfile" "-NonInteractive" "-Command" "(Get-CimInstance -ClassName 'Win32_Processor').NumberOfCores") | trim | atoi }}
{{-   $cpuThreads = (output "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" "-NoProfile" "-NonInteractive" "-Command" "(Get-CimInstance -ClassName 'Win32_Processor').NumberOfLogicalProcessors") | trim | atoi }}
{{- end }}

{{- $localDir := joinPath .chezmoi.homeDir ".local" -}}
{{- $homebrewPrefix := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   if eq .chezmoi.arch "arm64" -}}
{{-     $homebrewPrefix = "/opt/homebrew" -}}
{{-   else -}}
{{-     $homebrewPrefix = "/usr/local" -}}
{{-   end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $homebrewPrefix = "/home/linuxbrew/.linuxbrew" -}}
{{- end }}

[data]
  osid = {{ $osid | quote }}

  # XDG Base Directory specification
  xdg_config_home = {{ joinPath .chezmoi.homeDir ".config" | quote }}
  xdg_data_home = {{ joinPath $localDir "share" | quote }}
  xdg_cache_home = {{ joinPath .chezmoi.homeDir ".cache" | quote }}
  xdg_state_home = {{ joinPath $localDir "state" | quote }}

  # Local directory structure
  local_dir = {{ $localDir | quote }}

  # Rust environment
  rustup_home = {{ joinPath $localDir "share" "rustup" | quote }}
  cargo_home = {{ joinPath $localDir "share" "cargo" | quote }}

  # Haskell environment (via Homebrew)
  ghc_home = {{ joinPath $homebrewPrefix "opt" "ghc@9.6" | quote }}
  ghc_bin = {{ joinPath $homebrewPrefix "opt" "ghc@9.6" "bin" | quote }}
  # No cabal_home/CABAL_DIR: cabal-install >=3.10 follows the XDG Base
  # Directory spec on its own (config in XDG_CONFIG_HOME/cabal, cache in
  # XDG_CACHE_HOME/cabal, store in XDG_STATE_HOME/cabal, installed
  # executables in ~/.local/bin) as long as CABAL_DIR stays unset and no
  # legacy ~/.cabal directory exists.

  # Haskell environment (via ghcup, opt-in DOTFILES_FULL_INSTALL toolchain)
  # ghcup always appends ".ghcup" to this prefix itself.
  ghcup_install_base_prefix = {{ joinPath $localDir "share" | quote }}

  # Python environment (via pixi)
  pixi_home = {{ joinPath $localDir "share" "pixi" | quote }}

  # Julia environment (via juliaup)
  juliaup_home = {{ joinPath $localDir "share" "juliaup" | quote }}
  julia_depot_path = {{ joinPath $localDir "share" "julia" | quote }}

  # Homebrew paths (OS-aware)
  homebrew_prefix = {{ $homebrewPrefix | quote }}
  homebrew_cellar = {{ joinPath $homebrewPrefix "Cellar" | quote }}
  homebrew_repository = {{ $homebrewPrefix | quote }}

  # 1Password availability
  has1password = {{ $has1password }}

  # 1Password SSH agent (OS-specific path)
  {{- if eq .chezmoi.os "darwin" }}
  ssh_auth_sock = {{ joinPath .chezmoi.homeDir "Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" | quote }}
  {{- else if eq .chezmoi.os "windows" }}
  ssh_auth_sock = "\\\\.\\pipe\\openssh-ssh-agent"
  {{- else }}
  ssh_auth_sock = ""
  {{- end }}

  # Vars valid on every platform (bash/zsh/fish AND PowerShell) — single
  # source of truth for *which* vars each shell exports; see
  # dot_config/bash/env.sh.tmpl, dot_config/fish/env.fish.tmpl and
  # dot_config/powershell/profile.ps1.tmpl for the loops that consume this.
  [[data.env_vars]]
    name = "XDG_CONFIG_HOME"
    value = {{ joinPath .chezmoi.homeDir ".config" | quote }}
  [[data.env_vars]]
    name = "XDG_DATA_HOME"
    value = {{ joinPath $localDir "share" | quote }}
  [[data.env_vars]]
    name = "XDG_CACHE_HOME"
    value = {{ joinPath .chezmoi.homeDir ".cache" | quote }}
  [[data.env_vars]]
    name = "XDG_STATE_HOME"
    value = {{ joinPath $localDir "state" | quote }}
  [[data.env_vars]]
    name = "LOCAL"
    value = {{ $localDir | quote }}
  [[data.env_vars]]
    name = "LOCAL_BIN"
    value = {{ joinPath $localDir "bin" | quote }}
  [[data.env_vars]]
    name = "CONFIG"
    value = {{ joinPath .chezmoi.homeDir ".config" | quote }}
  [[data.env_vars]]
    name = "RUSTUP_HOME"
    value = {{ joinPath $localDir "share" "rustup" | quote }}
  [[data.env_vars]]
    name = "CARGO_HOME"
    value = {{ joinPath $localDir "share" "cargo" | quote }}
  [[data.env_vars]]
    name = "PIXI_HOME"
    value = {{ joinPath $localDir "share" "pixi" | quote }}
  [[data.env_vars]]
    name = "JULIAUP_HOME"
    value = {{ joinPath $localDir "share" "juliaup" | quote }}
  [[data.env_vars]]
    name = "JULIA_DEPOT_PATH"
    value = {{ joinPath $localDir "share" "julia" | quote }}
  [[data.env_vars]]
    name = "GHCUP_INSTALL_BASE_PREFIX"
    value = {{ joinPath $localDir "share" | quote }}
  [[data.env_vars]]
    name = "EDITOR"
    value = "hx"
  [[data.env_vars]]
    name = "PAGER"
    value = "bat"
  [[data.env_vars]]
    name = "GIT_PAGER"
    value = "delta"
  [[data.env_vars]]
    name = "FZF_DEFAULT_COMMAND"
    value = "fd --type file --color=always --follow --hidden --exclude .git"
  [[data.env_vars]]
    name = "FZF_CTRL_T_COMMAND"
    value = "fd --type file --color=always --follow --hidden --exclude .git"
  [[data.env_vars]]
    name = "FZF_DEFAULT_OPTS"
    value = "--ansi"

  # Homebrew vars — only meaningful on mac/linux (bash/zsh/fish); PowerShell/Windows
  # has no Homebrew, so this is a separate list that only those templates loop over.
  [[data.homebrew_env_vars]]
    name = "HOMEBREW_PREFIX"
    value = {{ $homebrewPrefix | quote }}
  [[data.homebrew_env_vars]]
    name = "HOMEBREW_CELLAR"
    value = {{ joinPath $homebrewPrefix "Cellar" | quote }}
  [[data.homebrew_env_vars]]
    name = "HOMEBREW_REPOSITORY"
    value = {{ $homebrewPrefix | quote }}

[data.cpu]
  cores = {{ $cpuCores }}
  threads = {{ $cpuThreads }}

[cd]
{{- if eq .chezmoi.os "windows" }}
  command = "pwsh"
{{- else }}
  command = "fish"
{{- end }}

[git]
  autoPush = false

[diff]
  pager = "delta"

[scriptEnv]
{{- if eq .chezmoi.os "darwin" }}
    PATH = "{{ joinPath $homebrewPrefix "bin" }}:{{ joinPath $homebrewPrefix "sbin" }}:{{ joinPath $localDir "share" "pixi" "bin" }}:{{ joinPath $localDir "share" "cargo" "bin" }}:{{ joinPath $homebrewPrefix "opt" "ghc@9.6" "bin" }}:{{ joinPath $localDir "bin" }}:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{- else if eq .chezmoi.os "linux" }}
    PATH = "{{ joinPath $homebrewPrefix "bin" }}:{{ joinPath $homebrewPrefix "sbin" }}:{{ joinPath $localDir "share" "pixi" "bin" }}:{{ joinPath $localDir "share" "cargo" "bin" }}:{{ joinPath $homebrewPrefix "opt" "ghc@9.6" "bin" }}:{{ joinPath $localDir "bin" }}:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{- else if eq .chezmoi.os "windows" }}
    PATH = "{{ joinPath .chezmoi.homeDir ".local" "scoop" "shims" | replace "\\" "/" }};{{ joinPath $localDir "share" "pixi" "bin" | replace "\\" "/" }};{{ joinPath $localDir "share" "cargo" "bin" | replace "\\" "/" }};{{ joinPath $localDir "bin" | replace "\\" "/" }};{{ joinPath .chezmoi.homeDir "AppData" "Local" "Microsoft" "WindowsApps" | replace "\\" "/" }};{{ joinPath .chezmoi.homeDir "AppData" "Local" "Microsoft" "WinGet" "Links" | replace "\\" "/" }};C:/Program Files/PowerShell/7;C:/Windows/System32;C:/Windows"
{{- end }}

