#!/usr/bin/env fish
# Haskell packages hash: {{ include "dot_config/haskellfile" | sha256sum }}

echo "Setting up Haskell environment..."

# Ensure system paths are included for configure scripts
fish_add_path "/bin"
fish_add_path "/usr/bin"
fish_add_path "{{ .homebrew_prefix }}/bin"
fish_add_path "{{ .homebrew_prefix }}/opt/ghc@9.6/bin"

# Check if GHC is installed via Homebrew
if not type -q ghc
    echo "Installing GHC via Homebrew..."
    brew install ghc@9.6
end

# Check if cabal is installed via Homebrew
if not type -q cabal
    echo "Installing cabal via Homebrew..."
    brew install cabal-install
end

# Update cabal package index
echo "Updating cabal package index..."
cabal update

# Read packages from haskellfile
set HASKELL_FILE "{{ .xdg_config_home }}/haskellfile"
if not test -f "$HASKELL_FILE"
    echo "Error: Haskell file not found at $HASKELL_FILE"
    exit 1
end

# Extract package names (ignore comments and empty lines)
set PACKAGES (grep -v '^#' "$HASKELL_FILE" | grep -v '^$' | sed 's/#.*//' | string trim)

if test -z "$PACKAGES"
    echo "No Haskell packages to install"
    exit 0
end

echo "Haskell packages to install: $PACKAGES"

{{- if hasKey .chezmoi "force" }}
{{- if .chezmoi.force }}
# Force mode - reinstall all packages
echo "Force mode enabled - reinstalling all Haskell packages..."
for package in $PACKAGES
    echo "Reinstalling $package..."
    cabal install --lib --force-reinstalls --overwrite-policy=always "$package"
end
{{- else }}
# Install each package if not already installed
for package in $PACKAGES
    # Check if package is already installed by querying ghc-pkg
    if not ghc-pkg list "$package" 2>/dev/null | grep -q "$package"
        echo "Installing $package..."
        cabal install --lib --overwrite-policy=always "$package"
    else
        echo "$package already installed"
    end
end
{{- end }}
{{- else }}
# Install each package if not already installed
for package in $PACKAGES
    # Check if package is already installed by querying ghc-pkg
    if not ghc-pkg list "$package" 2>/dev/null | grep -q "$package"
        echo "Installing $package..."
        cabal install --lib --overwrite-policy=always "$package"
    else
        echo "$package already installed"
    end
end
{{- end }}

echo "Haskell packages installation complete!"
echo ""
echo "TidalCycles has been installed!"
echo "Next steps:"
echo "  1. SuperCollider and SuperDirt will be installed automatically"
echo "  2. vim-tidal plugin is configured in neovim"
echo "  3. To use TidalCycles:"
echo "     - Start SuperCollider and run: SuperDirt.start"
echo "     - Open a .tidal file in neovim"
echo "     - Use <C-e> to send code to TidalCycles"
echo "  4. Docs: https://tidalcycles.org/docs/"
