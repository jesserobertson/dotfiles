{{- $is_container := false -}}
{{- if stat "/.dockerenv" -}}
{{-   $is_container = true -}}
{{- end -}}

{{- $skip_heavy := false -}}
{{- if or $is_container (env "HOMEBREW_SKIP_HEAVY") -}}
{{-   $skip_heavy = true -}}
{{- end -}}

{{- $skip_gui := false -}}
{{- if or $is_container (env "CI") -}}
{{-   $skip_gui = true -}}
{{- end -}}

{{- $full_install := false -}}
{{- if env "DOTFILES_FULL_INSTALL" -}}
{{-   $full_install = true -}}
{{- end -}}

{{ if eq .chezmoi.os "darwin" }}
cask_args appdir: "/Applications"

{{ if not $skip_gui }}
## TAPS
tap "FelixKratz/formulae"

## CASKS
# Utilities
cask "1password-cli"
cask "anki"
cask "chromium"
cask "claude-code"
cask "gcloud-cli"
cask "ghostty"
cask "raycast"
cask "nikitabobko/tap/aerospace"

# Fonts
cask "font-fira-code"
cask "font-fira-code-nerd-font"
cask "font-fira-mono-nerd-font"
cask "font-prompt"
{{ end }}
{{ end }}

## BREWS - cross-platform shell and dev essentials
brew "bash-completion@2"
brew "bat"
brew "bat-extras"
brew "chezmoi"
brew "direnv"
brew "eza"
brew "fd"
brew "fish"
brew "fisher"
brew "fzf"
brew "git"
brew "git-delta"
brew "gh"
brew "jq"
brew "just"
brew "neovim"
brew "openssl"
brew "pixi"
brew "readline"
brew "ripgrep"
brew "starship"
brew "tig"
brew "tmux"
brew "zoxide"
brew "zsh-completions"

## BREWS - not suitable for containers (heavy or host-only)
{{ if not $skip_heavy }}
brew "awscli"
brew "bats-core"
brew "cmake"
brew "coreutils"
brew "git-flow"
brew "gnupg"
brew "htop"
brew "juliaup"
brew "llm"
brew "openjdk"
brew "pandoc"
brew "roborev-dev/tap/roborev"
{{ end }}

## BREWS - heavy toolchains, opt-in only (set DOTFILES_FULL_INSTALL=1)
{{ if $full_install }}
brew "ghcup"
brew "golang"
brew "llvm"
brew "nodejs"
{{ end }}

## BREWS - macOS only
{{ if eq .chezmoi.os "darwin" }}
{{ if not $skip_gui }}
brew "borders"
{{ end }}
brew "dolt"
brew "lima"
brew "mactop"
{{ end }}
