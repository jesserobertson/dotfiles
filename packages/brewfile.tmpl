{{- $is_container := false -}}
{{- if or (stat "/.dockerenv") (env "CI") -}}
{{-   $is_container = true -}}
{{- end -}}

{{ if eq .chezmoi.os "darwin" }}
cask_args appdir: "/Applications"

## TAPS
{{ if not $is_container }}
tap "FelixKratz/formulae"
{{ end }}

## CASKS
# Utilities
cask "1password-cli"
cask "anki"
cask "chromium"
cask "claude-code"
cask "gcloud-cli"
cask "ghostty"
cask "raycast"
cask "nikitabobko/tap/aerospace"

# Fonts
cask "font-fira-code"
cask "font-fira-code-nerd-font"
cask "font-fira-mono-nerd-font"
cask "font-prompt"
{{ end }}

## BREWS - cross-platform shell and dev essentials
brew "bat"
brew "bat-extras"
brew "chezmoi"
brew "direnv"
brew "eza"
brew "fd"
brew "fish"
brew "fisher"
brew "fzf"
brew "git"
brew "git-delta"
brew "gh"
brew "jq"
brew "just"
brew "neovim"
brew "openssl"
brew "readline"
brew "ripgrep"
brew "starship"
brew "tig"
brew "tmux"
brew "zoxide"

## BREWS - not suitable for containers (heavy or host-only)
{{ if not $is_container }}
brew "awscli"
brew "bats-core"
brew "cmake"
brew "coreutils"
brew "ghcup"
brew "git-flow"
brew "gnupg"
brew "golang"
brew "htop"
brew "juliaup"
brew "llm"
brew "llvm"
brew "nodejs"
brew "openjdk"
brew "pandoc"
brew "pixi"
brew "roborev-dev/tap/roborev"
{{ end }}

## BREWS - macOS only
