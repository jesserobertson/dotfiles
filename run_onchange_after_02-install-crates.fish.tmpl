#!/usr/bin/env fish
# Crates list hash: {{ include "dot_config/cratefile" | sha256sum }}

# Source fish config to get PATH and environment variables
source ~/.config/fish/config.fish

# Add cargo bin to PATH if it exists
if test -d ~/.cargo/bin
    set -gx PATH ~/.cargo/bin $PATH
end

echo "Installing Rust crates..."

# Check if cargo is available
if not type -q cargo
    echo "Error: cargo not found. Please ensure Rust is installed."
    exit 1
end

# Read crates from Crates file and install them
set CRATES_FILE "{{ .xdg_config_home }}/cratefile"
if not test -f "$CRATES_FILE"
    echo "Error: Crates file not found at $CRATES_FILE"
    exit 1
end

# Extract crate names (ignore comments and empty lines)
set CRATES (grep -v '^#' "$CRATES_FILE" | grep -v '^$' | sed 's/#.*//')

if test -z "$CRATES"
    echo "No crates to install"
    exit 0
end

echo "Crates to install: $CRATES"

{{- if hasKey .chezmoi "force" }}
{{- if .chezmoi.force }}
# Force mode - reinstall all crates
echo "Force mode enabled - reinstalling all crates..."
for crate in $CRATES
    echo "Reinstalling $crate..."
    cargo install --force "$crate"
end
{{- else }}
# Install each crate if not already installed
for crate in $CRATES
    if not cargo install --list | grep -q "^$crate v"
        echo "Installing $crate..."
        cargo install "$crate"
    else
        echo "$crate already installed"
    end
end
{{- end }}
{{- else }}
# Install each crate if not already installed
for crate in $CRATES
    if not cargo install --list | grep -q "^$crate v"
        echo "Installing $crate..."
        cargo install "$crate"
    else
        echo "$crate already installed"
    end
end
{{- end }}

echo "Rust crates installation complete!"
