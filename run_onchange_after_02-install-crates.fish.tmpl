{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env fish
# Crates list hash: {{ include "dot_config/cratefile" | sha256sum }}

# Skip crate installation in CI environments to save time
if set -q CI
    echo "CI environment detected - skipping Rust crate installation"
    exit 0
end

# Set Rust environment variables (cargo needs these)
set -gx RUSTUP_HOME "{{ .rustup_home }}"
set -gx CARGO_HOME "{{ .cargo_home }}"
set -gx PATH "{{ .cargo_home }}/bin" $PATH

# Also source env.fish if it exists to get other environment variables
if test -f ~/.config/fish/env.fish
    source ~/.config/fish/env.fish
end

echo "Installing Rust crates..."

# Check if cargo is available
if not type -q cargo
    echo "Error: cargo not found. Please ensure Rust is installed."
    echo "RUSTUP_HOME: {{ .rustup_home }}"
    echo "CARGO_HOME: {{ .cargo_home }}"
    echo "Current PATH: $PATH"
    # List what's actually in the cargo bin directory
    echo "Contents of {{ .cargo_home }}/bin:"
    ls -la "{{ .cargo_home }}/bin" 2>/dev/null; or echo "Directory does not exist"
    exit 1
end

# Read crates from Crates file and install them
set CRATES_FILE "{{ .xdg_config_home }}/cratefile"
if not test -f "$CRATES_FILE"
    echo "Error: Crates file not found at $CRATES_FILE"
    exit 1
end

# Extract crate names (ignore comments and empty lines)
set CRATES (grep -v '^#' "$CRATES_FILE" | grep -v '^$' | sed 's/#.*//')

if test -z "$CRATES"
    echo "No crates to install"
    exit 0
end

echo "Crates to install: $CRATES"

{{- if hasKey .chezmoi "force" }}
{{- if .chezmoi.force }}
# Force mode - reinstall all crates
echo "Force mode enabled - reinstalling all crates..."
for crate in $CRATES
    echo "Reinstalling $crate..."
    cargo install --force "$crate"
end
{{- else }}
# Install each crate if not already installed
for crate in $CRATES
    if not cargo install --list | grep -q "^$crate v"
        echo "Installing $crate..."
        cargo install "$crate"
    else
        echo "$crate already installed"
    end
end
{{- end }}
{{- else }}
# Install each crate if not already installed
for crate in $CRATES
    if not cargo install --list | grep -q "^$crate v"
        echo "Installing $crate..."
        cargo install "$crate"
    else
        echo "$crate already installed"
    end
end
{{- end }}

echo "Rust crates installation complete!"
{{- end -}}
