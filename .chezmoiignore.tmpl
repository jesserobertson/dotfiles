# Skip 1Password-dependent files when op CLI is not available (CI or no 1Password installed)
{{- if or (not .has1password) (env "CI") (env "GITHUB_ACTIONS") (env "GITLAB_CI") }}
.aws/config
.gitconfig
{{ end -}}

# Skip non-Windows files on Windows
{{- if eq .chezmoi.os "windows" }}
.config/fish
.config/tmux
.config/alacritty
.config/bash
.config/zsh
.bashrc
.zshrc
00-install-prereqs.sh
00-install-brews.sh
01-install-rust.fish
02-install-crates.fish
03-install-extras.sh
06-install-tmux-plugins.sh
{{ end -}}

# Skip Windows-only files on non-Windows
{{- if ne .chezmoi.os "windows" }}
.config/powershell
07-setup-powershell.ps1
{{ end -}}

# rustup is a heavy, opt-in toolchain (not a brew formula, so it's gated here
# rather than in brewfile.tmpl) — only installed when DOTFILES_FULL_INSTALL=1.
# Crate installation depends on cargo, so it's gated the same way — otherwise
# it fails outright when rustup was skipped.
{{- if not (env "DOTFILES_FULL_INSTALL") }}
01-install-rust.fish
02-install-crates.fish
{{ end -}}
