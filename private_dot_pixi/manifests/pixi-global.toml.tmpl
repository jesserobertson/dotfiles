version = 1

# Python development environment
[envs.python]
channels = ["conda-forge"]
dependencies = { python = ">=3.11", ipython = "*", jupyter = "*", jupyterlab = "*", marimo = "*", ruff = "*", pyright = "*", mypy = "*" }
exposed = { python = "python", python3 = "python", ipython = "ipython", jupyter = "jupyter", jupyter-lab = "jupyter-lab", marimo = "marimo", ruff = "ruff", pyright = "pyright", mypy = "mypy" }

