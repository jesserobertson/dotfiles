{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
exit 0
{{- end }}
# Bootstrap scoop and install scoop/cargo packages from package definitions.
# Winget packages are handled by scripts/install-prereqs.ps1 (run before chezmoi apply).
# scoopfile hash: {{ include "packages/scoopfile" | sha256sum }}
# scoopfile.full hash: {{ include "packages/scoopfile.full" | sha256sum }}
# cratefile hash: {{ include "packages/cratefile" | sha256sum }}

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

# Ensure SCOOP points to our XDG-friendly location BEFORE the installer runs,
# so scoop installs there rather than the default ~/scoop.
if (-not $env:SCOOP) {
    $env:SCOOP = Join-Path $HOME ".local" "scoop"
}

# --- Bootstrap scoop ---
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "Installing scoop..."
    Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
    Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
}

$scoopShims = Join-Path $env:SCOOP "shims"
if ($env:PATH -notlike "*$scoopShims*") {
    $env:PATH = "$scoopShims;$env:PATH"
}

# --- Scoop packages ---
function Install-ScoopPackages($scoopfile) {
    $packages = Get-Content $scoopfile |
        Where-Object { $_ -notmatch '^\s*#' -and $_ -match '\S' }
    foreach ($pkg in $packages) {
        $name = ($pkg -split '/') | Select-Object -Last 1
        if (-not (scoop list $name 2>$null | Select-String $name -Quiet)) {
            Write-Host "Installing (scoop) $pkg..."
            scoop install $pkg
        }
    }
}

Install-ScoopPackages (Join-Path "{{ .chezmoi.sourceDir }}" "packages" "scoopfile")

{{ if env "DOTFILES_FULL_INSTALL" -}}
# Heavy/opt-in toolchains (DOTFILES_FULL_INSTALL is set)
Install-ScoopPackages (Join-Path "{{ .chezmoi.sourceDir }}" "packages" "scoopfile.full")

# --- Rust crates ---
# rustup only installs above when DOTFILES_FULL_INSTALL is set, so only
# attempt crate installation in that case too — otherwise there's no cargo.
& "{{ .chezmoi.sourceDir }}\scripts\install-crates.ps1"
{{ end -}}
