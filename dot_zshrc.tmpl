# Single source of truth for env vars: dot_config/bash/env.sh.tmpl (data in .chezmoi.toml.tmpl)
source "{{ .xdg_config_home }}/zsh/env.zsh"

# Helper: run a tool's init command once per binary version, caching to XDG_CACHE_HOME.
# Mirrors the PowerShell profile's starship-init caching pattern.
_init_cached() {
    local tool="$1"; shift
    local binary
    binary="$(command -v "$tool" 2>/dev/null)" || return 0
    local mtime
    mtime="$(stat -c '%Y' "$binary" 2>/dev/null || stat -f '%m' "$binary" 2>/dev/null || echo '0')"
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
    local cache_file="$cache_dir/${tool}_init_${mtime}.zsh"
    if [[ ! -f "$cache_file" ]]; then
        mkdir -p "$cache_dir"
        rm -f "$cache_dir/${tool}_init_"*.zsh
        "$@" > "$cache_file" 2>/dev/null
        [[ -s "$cache_file" ]] || rm -f "$cache_file"
    fi
    [[ -s "$cache_file" ]] && source "$cache_file"
}

# Completions (Homebrew-installed zsh-completions + per-formula scripts).
# Only fully rescan fpath once every 24h (compinit -C skips the security
# check and is much faster on every other shell startup).
if [[ -o interactive ]]; then
    fpath=("$HOMEBREW_PREFIX/share/zsh-completions" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
    autoload -Uz compinit
    _zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
    mkdir -p "${_zcompdump:h}"
    if [[ -n "${_zcompdump}"(#qN.mh+24) ]]; then
        compinit -d "$_zcompdump"
    else
        compinit -C -d "$_zcompdump"
    fi
    unset _zcompdump
fi

# Tool integrations (cached by binary mtime — only regenerated after upgrades)
if [[ -o interactive ]]; then
    _init_cached fzf     fzf --zsh
    _init_cached starship starship init zsh
    _init_cached zoxide  zoxide init zsh
    _init_cached direnv  direnv hook zsh
    _init_cached batpipe batpipe
    _init_cached batman  batman --export-env
fi

# Function to safely add path only if directory exists and is readable
safe_add_path() {
    local dir="$1"
    local prepend="$2"

    # Check if directory exists and is readable
    if [ -d "$dir" ] && [ -r "$dir" ]; then
        # Check if path is not already in PATH
        case ":$PATH:" in
            *":$dir:"*) ;;  # Already in PATH
            *)
                if [ "$prepend" = "prepend" ]; then
                    export PATH="$dir:$PATH"
                else
                    export PATH="$PATH:$dir"
                fi
                ;;
        esac
    fi
}

# Paths not covered by env.sh's PATH
safe_add_path "$HOMEBREW_PREFIX/opt/java/bin" prepend
safe_add_path "${ASDF_DATA_DIR:-$HOME/.asdf}/shims" prepend
