{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "padding": 0
  },
  "vimMode": true,
  "defaultPermissionMode": "plan",
  "allowedTools": [
    "Read",
    "Write",
    "Edit",
    "MultiEdit",
    "Glob",
    "Grep",
    "Bash",
    "Bash(gh pr diff:*)",
    "Bash(gh pr list:*)",
    "Bash(gh pr review-comment list:*)",
    "Bash(gh pr view:*)",
    "Bash(gh run list:*)",
    "Bash(gh run view:*)",
    "Bash(rg:*)",
    "Bash(ls:*)",
    "Bash(fd:*)",
    "Bash(find:*)",
    "Bash(command -v:*)",
    "TodoWrite",
    "Task"
  ],
  "disallowedTools": [],
  "outputFormat": "text",
  "verboseMode": true
}
