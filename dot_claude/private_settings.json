{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "permissions": {
    "allow": [
      "Bash(bd:*)",
      "Bash(pixi:*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "padding": 0
  },
  "allowedTools": [
    "Read",
    "Write",
    "Edit",
    "MultiEdit",
    "Glob",
    "Grep",
    "Bash",
    "Bash(gh pr diff:*)",
    "Bash(gh pr list:*)",
    "Bash(gh pr review-comment list:*)",
    "Bash(gh pr view:*)",
    "Bash(gh run list:*)",
    "Bash(gh run view:*)",
    "Bash(rg:*)",
    "Bash(ls:*)",
    "Bash(fd:*)",
    "Bash(find:*)",
    "Bash(command -v:*)",
    "TodoWrite",
    "Task"
  ],
  "defaultPermissionMode": "plan",
  "disallowedTools": [],
  "outputFormat": "text",
  "verboseMode": true,
  "vimMode": true,
  "enabledPlugins": {
    "beads@beads-marketplace": true
  }
}
