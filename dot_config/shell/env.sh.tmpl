# SHELL ENVIRONMENT VARIABLES
# This file can be sourced by both bash and zsh

# XDG Base Directory specification
export XDG_CONFIG_HOME="{{ .xdg_config_home }}"
export XDG_DATA_HOME="{{ .xdg_data_home }}"
export XDG_CACHE_HOME="{{ .xdg_cache_home }}"
export XDG_STATE_HOME="{{ .xdg_state_home }}"

# Local directory structure
export LOCAL="{{ .local_dir }}"

# Rust environment
export RUSTUP_HOME="{{ .rustup_home }}"
export CARGO_HOME="{{ .cargo_home }}"

# Haskell environment (via Homebrew)
export CABAL_DIR="{{ .cabal_home }}"

# Python environment (via pixi)
export PIXI_HOME="{{ .pixi_home }}"

# Set up shell tools
export EDITOR="{{ .editor }}"
export PAGER="{{ .pager }}"
export GIT_PAGER="{{ .git_pager }}"

# Configure fzf and fd
export FZF_DEFAULT_COMMAND="fd --type file --color=always --follow --hidden --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS="--ansi"

# Add 1Password SSH agent
export SSH_AUTH_SOCK="{{ .ssh_auth_sock }}"

# Add local paths
export CONFIG="$HOME/.config"
export LOCAL_BIN="$LOCAL/bin"

# Add homebrew
export HOMEBREW_PREFIX="{{ .homebrew_prefix }}"
export HOMEBREW_CELLAR="{{ .homebrew_cellar }}"
export HOMEBREW_REPOSITORY="{{ .homebrew_repository }}"

# Set up manuals and docs
export MANPATH="$LOCAL/share/man:$HOMEBREW_PREFIX/share/man${MANPATH:+:$MANPATH}"
export INFOPATH="$LOCAL/share/info:$HOMEBREW_PREFIX/share/info${INFOPATH:+:$INFOPATH}"

# Set PATH
export PATH="{{ .ghc_bin }}:$CABAL_DIR/bin:$PIXI_HOME/bin:$CARGO_HOME/bin:$HOMEBREW_PREFIX/sbin:$HOMEBREW_PREFIX/bin:$LOCAL/bin:$PATH"
