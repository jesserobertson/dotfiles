# BASH ENVIRONMENT VARIABLES
# Generated from chezmoi data - single source of truth

# Vars defined once in .chezmoi.toml.tmpl's [[data.env_vars]] /
# [[data.homebrew_env_vars]] — add a new var there, not here.
{{- range .env_vars }}
export {{ .name }}="{{ .value }}"
{{- end }}

{{- range .homebrew_env_vars }}
export {{ .name }}="{{ .value }}"
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# 1Password SSH agent (macOS only)
export SSH_AUTH_SOCK="{{ .ssh_auth_sock }}"
{{- end }}

# Add to PATH
export PATH="{{ .local_dir }}/bin:{{ .pipx_bin_dir }}:{{ .homebrew_prefix }}/bin:{{ .homebrew_prefix }}/sbin:{{ .cargo_home }}/bin:{{ .ghc_bin }}:{{ .pixi_home }}/bin:{{ .juliaup_home }}/bin:$PATH"

# Set up MANPATH and INFOPATH
export MANPATH="{{ .local_dir }}/share/man:{{ .homebrew_prefix }}/share/man:$MANPATH"
export INFOPATH="{{ .local_dir }}/share/info:{{ .homebrew_prefix }}/share/info:$INFOPATH"
