# Portable tmux config: the same file runs under tmux on Linux/macOS and psmux
# on Windows, so it uses only built-in options, no plugins and no shell scripts.

# -- options -------------------------------------------------------------------
set -g default-terminal "xterm-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -g mouse off
set -g base-index 0
set -g escape-time 10
set -g history-limit 50000

# -- prefix --------------------------------------------------------------------
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# -- bindings ------------------------------------------------------------------
bind r source-file ~/.config/tmux/tmux.conf \; display-message "Config reloaded"

# split panes, keeping the current directory
bind | split-window -h -c "#{pane_current_path}"
bind '\' split-window -fh -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind _ split-window -fv -c "#{pane_current_path}"

# move between panes
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# resize panes
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
bind -r < resize-pane -L 1
bind -r > resize-pane -R 1

# swap panes
bind '{' swap-pane -U
bind '}' swap-pane -D

# layouts - e and v for even horizontal/vertical splits, p for programming
bind-key e select-layout even-horizontal
bind-key v select-layout even-vertical
bind-key p select-layout main-vertical \; resize-pane -t 0 -x 120

# watch an agent work: from the agent's pane, add a log pane on the right (30%)
# and a shell strip underneath (25%), and come back to the agent
bind-key a split-window -h -l 30% -c "#{pane_current_path}" \; select-pane -L \; split-window -v -l 25% -c "#{pane_current_path}" \; select-pane -U

# a quick shell in a floating pane over the current window, closed on exit
{{ if eq .chezmoi.os "windows" -}}
bind-key g display-popup -w 60% -h 50% -E 'pwsh -NoProfile'
{{- else -}}
bind-key g display-popup -w 60% -h 50% -E
{{- end }}

# -- status line (Dracula colours, built-in formats only) ------------------------
set -g status-position bottom
set -g status-interval 5
set -g status-style "bg=#282a36,fg=#f8f8f2"
set -g status-left-length 30
set -g status-left "#[bg=#bd93f9,fg=#282a36,bold] #S #[default] "
set -g status-right "#[bg=#6272a4,fg=#f8f8f2] %a %d %b #[bg=#bd93f9,fg=#282a36,bold] %H:%M "
setw -g window-status-format " #I #W#F "
setw -g window-status-current-format "#[bg=#44475a,fg=#50fa7b,bold] #I #W#F "
set -g pane-border-status top
set -g pane-border-format " #{pane_index}: #{pane_title} [#{pane_current_command}] "
set -g pane-border-style "fg=#44475a"
set -g pane-active-border-style "fg=#bd93f9"
set -g message-style "bg=#44475a,fg=#f8f8f2"
