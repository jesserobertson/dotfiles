# FISH ENVRIONMENT VARIABLES
# XDG Base Directory specification
set -gx XDG_CONFIG_HOME "{{ .xdg_config_home }}"
set -gx XDG_DATA_HOME "{{ .xdg_data_home }}"
set -gx XDG_CACHE_HOME "{{ .xdg_cache_home }}"
set -gx XDG_STATE_HOME "{{ .xdg_state_home }}"

# Local directory structure
set -gx LOCAL "{{ .local_dir }}"

# Rust environment
set -gx RUSTUP_HOME "{{ .rustup_home }}"
set -gx CARGO_HOME "{{ .cargo_home }}"

# Set up shell tools
set -gx EDITOR nvim
set -gx PAGER less
set -gx GIT_PAGER delta

# Configure fzf and fd
export FZF_DEFAULT_COMMAND="fd --type file --color=always --follow --hidden
--exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS="--ansi"

# Add 1Password SSH agent
set -gx SSH_AUTH_SOCK "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Add local paths
set -gx CONFIG "$HOME/.config"
set -gx LOCAL_BIN "$LOCAL/bin"

# Add homebrew
set -gx HOMEBREW_PREFIX /opt/homebrew
set -gx HOMEBREW_CELLAR /opt/homebrew/Cellar
set -gx HOMEBREW_REPOSITORY /opt/homebrew

# Set up manuals and docs
set -q MANPATH; or set MANPATH ''
set -gx MANPATH "$LOCAL/share/man" "$HOMEBREW_PREFIX/share/man" $MANPATH
set -q INFOPATH; or set INFOPATH ''
set -gx INFOPATH "$LOCAL/share/info" "$HOMEBREW_PREFIX/share/info" $INFOPATH

# Set path in one hit
fish_add_path "$LOCAL/bin"
fish_add_path "$HOMEBREW_PREFIX/bin"
fish_add_path "$HOMEBREW_PREFIX/sbin"
fish_add_path "$CARGO_HOME/bin"

