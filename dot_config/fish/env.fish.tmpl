# FISH ENVIRONMENT VARIABLES
# Generated from chezmoi data - single source of truth
# See .chezmoi.toml.tmpl for the data definitions

# Vars defined once in .chezmoi.toml.tmpl's [[data.env_vars]] /
# [[data.homebrew_env_vars]] — add a new var there, not here.
{{- range .env_vars }}
set -gx {{ .name }} "{{ .value }}"
{{- end }}

{{- range .homebrew_env_vars }}
set -gx {{ .name }} "{{ .value }}"
{{- end }}

# Add 1Password SSH agent
{{- if .ssh_auth_sock }}
set -gx SSH_AUTH_SOCK "{{ .ssh_auth_sock }}"
{{- end }}

# Set up manuals and docs
set -q MANPATH; or set MANPATH ''
set -gx MANPATH "$LOCAL/share/man" "$HOMEBREW_PREFIX/share/man" $MANPATH
set -q INFOPATH; or set INFOPATH ''
set -gx INFOPATH "$LOCAL/share/info" "$HOMEBREW_PREFIX/share/info" $INFOPATH

# Set path in one hit
fish_add_path "$LOCAL/bin"
fish_add_path "$HOMEBREW_PREFIX/bin"
fish_add_path "$HOMEBREW_PREFIX/sbin"
fish_add_path "$HOMEBREW_PREFIX/opt/java/bin"
fish_add_path "$PIXI_HOME/bin"
fish_add_path "$CARGO_HOME/bin"
fish_add_path "{{ .ghc_bin }}"
fish_add_path "$JULIAUP_HOME/bin"
