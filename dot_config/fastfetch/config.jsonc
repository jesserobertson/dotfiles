{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "Windows 95"
    },
    "modules": [
        "Title",
        "Separator",
        "OS",
        "Host",
        "Kernel",
        "Uptime",
        "Break",
        {
            "type": "CPU",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "type": "GPU",
            "temp": true
        },
        {
            "type": "Memory",
            "key": "RAM"
        },
        "Break",
        "Disk",
        "Battery",
        "Break",
        "Display",
        "Break",
        {
            "type": "LocalIP",
            "showIpv4": true,
            "showIpv6": false
        },
        "Break",
        "Terminal",
        "Shell"
    ]
}
