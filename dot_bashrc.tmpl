# XDG Base Directory specification
export XDG_CONFIG_HOME="{{ .xdg_config_home }}"
export XDG_DATA_HOME="{{ .xdg_data_home }}"
export XDG_CACHE_HOME="{{ .xdg_cache_home }}"
export XDG_STATE_HOME="{{ .xdg_state_home }}"

# Local directory structure
export LOCAL="{{ .local_dir }}"

# Rust environment
export RUSTUP_HOME="{{ .rustup_home }}"
export CARGO_HOME="{{ .cargo_home }}"

# Haskell environment (via Homebrew)
export CABAL_DIR="{{ .cabal_home }}"

# Shell tools
export EDITOR=nvim
export PAGER=less
export GIT_PAGER=delta

# Add 1Password SSH agent
{{- if .ssh_auth_sock }}
export SSH_AUTH_SOCK="{{ .ssh_auth_sock }}"
{{- end }}

# Add local paths
export CONFIG="$HOME/.config"
export LOCAL_BIN="$LOCAL/bin"

# Add brew to path
export HOMEBREW_PREFIX="{{ .homebrew_prefix }}"
export HOMEBREW_CELLAR="{{ .homebrew_cellar }}"
export HOMEBREW_REPOSITORY="{{ .homebrew_repository }}"

# Set up manuals and docs
export MANPATH="$LOCAL/share/man:$HOMEBREW_PREFIX/share/man${MANPATH:+:$MANPATH}"
export INFOPATH="$LOCAL/share/info:$HOMEBREW_PREFIX/share/info${INFOPATH:+:$INFOPATH}"

# Set up FZF
export FZF_DEFAULT_COMMAND="fd --type file --follow --hidden --exclude .git
--color=always"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS="--ansi"

# Helper: run a tool's init command once per binary version, caching to XDG_CACHE_HOME.
# Mirrors the PowerShell profile's starship-init caching pattern.
_init_cached() {
    local tool="$1"; shift
    local binary
    binary="$(command -v "$tool" 2>/dev/null)" || return 0
    local mtime
    mtime="$(stat -c '%Y' "$binary" 2>/dev/null || stat -f '%m' "$binary" 2>/dev/null || echo '0')"
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/bash"
    local cache_file="$cache_dir/${tool}_init_${mtime}.bash"
    if [ ! -f "$cache_file" ]; then
        mkdir -p "$cache_dir"
        rm -f "$cache_dir/${tool}_init_"*.bash
        "$@" > "$cache_file" 2>/dev/null
    fi
    [ -f "$cache_file" ] && source "$cache_file"
}

# Tool integrations (cached by binary mtime — only regenerated after upgrades)
_init_cached fzf    fzf --bash
_init_cached starship starship init bash
_init_cached zoxide zoxide init bash
_init_cached direnv direnv hook bash
_init_cached batpipe batpipe
_init_cached batman batman --export-env

# Function to safely add path only if directory exists and is readable
safe_add_path() {
    local dir="$1"
    local prepend="$2"

    # Check if directory exists and is readable
    if [ -d "$dir" ] && [ -r "$dir" ]; then
        # Check if path is not already in PATH
        case ":$PATH:" in
            *":$dir:"*) ;;  # Already in PATH
            *)
                if [ "$prepend" = "prepend" ]; then
                    export PATH="$dir:$PATH"
                else
                    export PATH="$PATH:$dir"
                fi
                ;;
        esac
    fi
}

# Set path using safe_add_path (in reverse order for prepending)
safe_add_path "{{ .ghc_bin }}" prepend
safe_add_path "$CABAL_DIR/bin" prepend
safe_add_path "$CARGO_HOME/bin" prepend
safe_add_path "$HOMEBREW_PREFIX/opt/java/bin" prepend
safe_add_path "$LOCAL/bin" prepend
safe_add_path "$HOMEBREW_PREFIX/bin" prepend
safe_add_path "$HOMEBREW_PREFIX/sbin" prepend

# Add ASDF to path (always prepend if shims directory exists)
safe_add_path "${ASDF_DATA_DIR:-$HOME/.asdf}/shims" prepend
